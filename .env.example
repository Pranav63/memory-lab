OPENAI_ENV_FILE=/absolute/path/to/existing/.env
OPENAI_KEY_NAME=OPENAI_API_KEY
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.2-2025-12-11
GROQ_ENV_FILE=/absolute/path/to/existing/.env.local
GROQ_KEY_NAME=GROQ_API_KEY
GRAPH_MODEL=openai/gpt-oss-120b
LOCAL_MODEL=glm4-en:latest
GRAPH_PORT=6390
ARTIFICIAL_ANALYSIS_API_KEY=
# Or reference an existing local file:
# ARTIFICIAL_ANALYSIS_ENV_FILE=/absolute/path/to/existing/.env
# ARTIFICIAL_ANALYSIS_KEY_NAME=ARTIFICIAL_ANALYSIS_API_KEY

TAVILY_ENV_FILE=/absolute/path/to/existing/.env.local
TAVILY_KEY_NAME=TAVILY_API_KEY
# Or configure TAVILY_API_KEY directly on the backend.
